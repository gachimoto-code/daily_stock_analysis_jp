# ============================================================
# daily_stock_analysis（日本株・私用版）環境変数サンプル
# 使い方: このファイルを .env にコピーして、使う項目だけ実値を入れる。
# ★ .env は絶対に Git へコミットしないこと（.gitignore で除外済み）。
# 元リポジトリの .env.example（A股中心・全項目）から、日本株の私用運用に
# 必要な項目だけを抜粋したもの。日本株に効かないデータ源キー
# （TUSHARE_TOKEN / TICKPLUS / FINNHUB / ALPHAVANTAGE / LONGBRIDGE 等）は
# 省略してある。日本株の相場取得は yfinance 経由で、キーは不要。
# ============================================================

# ------------------------------------------------------------
# 1. 対象銘柄（必須）
# ★ 必ず「証券コード.T」形式で書くこと。裸のコードは A股と誤判定される。
#    下記はスモークテスト用の初期値（トヨタ・ソニーG・ソフトバンクG・三菱UFJ FG）。
# ------------------------------------------------------------
STOCK_LIST=7203.T,6758.T,9984.T,8306.T

# ------------------------------------------------------------
# 2. LLM（AI分析に最低1つ必須。使うものだけコメントを外して入れる）
# ------------------------------------------------------------

# 候補A: Gemini（無料枠あり。https://aistudio.google.com で発行）
GEMINI_API_KEY=
# 複数キーの負荷分散を使う場合: GEMINI_API_KEYS=key1,key2,key3

# 候補B: DeepSeek（低価格・従量。https://platform.deepseek.com ）
# DEEPSEEK_API_KEY=

# 候補C: Anthropic Claude（https://console.anthropic.com ）
# ANTHROPIC_API_KEY=

# 候補C': OpenAI / OpenAI互換API
# OPENAI_API_KEY=
# OPENAI_BASE_URL=            # 互換APIを使う場合のみ。空なら公式

# 候補D: 集約系（1キーで複数モデルを切替。プロジェクト推奨）
# MODELFLARE_KEY=
# AIHUBMIX_KEY=

# モデルを明示したい場合（任意。LiteLLM形式）
# LITELLM_MODEL=

# 生成バックエンド: 通常は litellm のまま。
# ローカルCLI（Codex / Claude Code、実験的）に変える場合のみ変更する。
GENERATION_BACKEND=litellm

# 候補E: Ollama ローカルモデル（キー不要。ローカル/Docker実行専用）
# OLLAMA_API_BASE=http://localhost:11434

# ------------------------------------------------------------
# 3. ニュース検索キー（任意だが、無いとニュース面は空になる。最低1つ推奨）
# ------------------------------------------------------------

# SerpApi（推奨。日本語検索と相性がよい）
SERPAPI_API_KEYS=

# Tavily
TAVILY_API_KEYS=

# Brave Search API
BRAVE_API_KEYS=

# SearXNG 自建インスタンス（キー不要。公共インスタンスの自動利用は既定オフ）
SEARXNG_BASE_URLS=
SEARXNG_PUBLIC_INSTANCES_ENABLED=false

# ------------------------------------------------------------
# 4. レポート・実行設定
# ------------------------------------------------------------

# レポート言語: zh / en / ko の3択のみ（日本語設定はない）。当面は en で運用。
REPORT_LANGUAGE=en

# レポート種別: simple（精簡）/ full（完整）/ brief（要約のみ）
REPORT_TYPE=simple

# 大盤レビュー（日経225 / TOPIX）を有効化し、地域を日本にする
MARKET_REVIEW_ENABLED=true
MARKET_REVIEW_REGION=jp

# ローカル定時実行の時刻（--schedule 使用時）
SCHEDULE_TIME=19:00

# 銘柄ごとの分析間隔（秒）。LLMのレート制限に当たる場合は増やす
ANALYSIS_DELAY=0

# ------------------------------------------------------------
# 5. 通知（任意。使うものだけ。最初は全部空でよい＝通知なし）
# ------------------------------------------------------------

# メール（SMTP。パスワード欄には各サービスの「アプリパスワード/授権码」を入れる）
# EMAIL_SENDER=
# EMAIL_PASSWORD=
# EMAIL_RECEIVERS=            # 空なら自分宛て

# Telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Discord（Webhook）
# DISCORD_WEBHOOK_URL=

# カスタム Webhook（Bark 等もここ）
# CUSTOM_WEBHOOK_URLS=

# 個股分析と大盤レビューを1通にまとめる（メール通知時）
# MERGE_EMAIL_NOTIFICATION=false
